# Sentinel Backend Configuration
# Copy this to .env and fill in values

# Server
PORT=8080
GIN_MODE=debug

# PostgreSQL (RDS)
DB_HOST=
DB_PORT=5432
DB_USER=sentinel_admin
DB_PASSWORD=
DB_NAME=sentinel
DB_SSLMODE=require

# Redis (ElastiCache)
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=vscode
S3_BUCKET=sentinel-attachments-355458268570

# SES
SES_FROM_OTP=noreply@sentinel.yssn.tech
SES_FROM_ALERT=alert@sentinel.yssn.tech

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5

# File Upload
MAX_FILE_SIZE_MB=10
