# Sentinel Backend Configuration
# Copy this to .env and fill in your values

# Server
PORT=8080
GIN_MODE=release

# PostgreSQL
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=sentinel
DB_SSLMODE=require

# Redis
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_SECRET=

# AWS
AWS_REGION=
S3_BUCKET=

# SES (email sender addresses)
SES_FROM_OTP=
SES_FROM_ALERT=

# Email asset base URL (used in HTML email templates)
EMAIL_ASSETS_BASE_URL=

# CORS (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# OTP
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=5

# File Upload
MAX_FILE_SIZE_MB=10
